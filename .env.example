# Use Cloudflare Worker Variables and Secrets. Never commit real secrets.
APP_BASE_URL=https://hiramshot.com
NEXT_PUBLIC_SITE_URL=
CUSTOM_DOMAIN=hiramshot.com
ADMIN_CONTACT_EMAIL=hiramshotcamerarentals@gmail.com
CONTACT_EMAIL=hiramshotcamerarentals@gmail.com
ADMIN_EMAIL=hiramshotcamerarentals@gmail.com
# Only this verified email allowlist grants operator access; contact addresses do not.
ADMIN_ACCESS_EMAILS=
ADMIN_USER_IDS=
PUBLIC_INDEXING_ENABLED=false
KYC_ENABLED=false
KYC_RETENTION_DAYS=7
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
# Base64-encoded random 32-byte AES key.
DATA_ENCRYPTION_KEY=
# Independent random secrets; provision using secure runtime settings.
ADMIN_SESSION_SECRET=
AUDIT_HMAC_KEY=
DOWNLOAD_SECRET=
PURGE_SECRET=

# Google OAuth web client; configure through Worker settings.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=true
REVIEW_MODE=true

# Email/password stays off until verified email delivery, CAPTCHA, hashing
# performance on the selected Worker plan, and reset acceptance checks pass.
PASSWORD_AUTH_ENABLED=false
PASSWORD_HASHING_VERIFIED=false
AUTH_EMAIL_FROM=accounts@hiramshot.com
RESEND_API_KEY=

# Public review media requires private decode/re-encode, metadata removal and scan.
REVIEW_MEDIA_ENABLED=false
REVIEW_MEDIA_PROCESSOR_URL=
REVIEW_MEDIA_PROCESSOR_TOKEN=
